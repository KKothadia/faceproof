[flake8]
max-line-length = 120
# Only fail CI on real defects (syntax errors, undefined names, duplicate args).
# Style nits (unused imports, bare f-strings, line length) are pre-existing and
# out of scope for this pass - this repo doesn't enforce a strict style guide.
select = E9,F821,F822,F823,F831
exclude = .venv,.git,__pycache__,artifacts,models,logs
