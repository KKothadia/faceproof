# --- Search provider (required) ---
# SerpApi key used for the genuine Google Lens reverse-image search.
# Get one at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# --- Blockchain (required for the anchoring/read-back stages) ---
# Base Sepolia is a free public Ethereum L2 testnet - no real funds involved.
# Must be https:// (enforced by Config.validate()) unless it points at a local/simulated
# chain (localhost/127.0.0.1), e.g. for testing against a local Anvil/Hardhat node.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Private key of a throwaway Base Sepolia testnet wallet (get test ETH from
# https://www.alchemy.com/faucets/base-sepolia). NEVER use a wallet holding real funds.
PRIVATE_KEY=your_wallet_private_key
# Address of your deployed EvidenceRegistry contract (run scripts/deploy_contract.py, see README).
CONTRACT_ADDRESS=your_deployed_contract_address

# --- Face analysis (optional - sensible defaults shown) ---
# Minimum YuNet detection confidence to accept a face, in (0, 1].
FACE_DETECTION_THRESHOLD=0.80
# Minimum SFace cosine similarity for a candidate to count as a verified identity match, in (0, 1].
# Do not lower this to force a match - see README "Tuning the match threshold".
FACE_MATCH_COSINE_THRESHOLD=0.65
# Local paths to the OpenCV model files (downloaded by scripts/download_models.py).
MODEL_YUNET_PATH=models/face_detection_yunet_2023mar.onnx
MODEL_SFACE_PATH=models/face_recognition_sface_2021dec.onnx

# --- Search/media limits (optional) ---
# Max candidate media size accepted from a search result, in megabytes.
MAX_MEDIA_SIZE_MB=8.0
# Max number of search candidates processed per run (caps download/verification cost
# and bounds exposure to SerpApi rate limits on large result sets).
MAX_SEARCH_RESULTS=20
# Cache identical repeated searches (same input image, by content hash) on disk under
# .cache/serpapi_search/, so re-running the demo on the same photo doesn't burn API quota.
# Set to false to always hit SerpApi live.
SEARCH_CACHE_ENABLED=true
